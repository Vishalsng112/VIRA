+class _ConflictsPageState extends State<ConflictsPage> {
+  String get _h => widget.api.householdId!;
+  List<Json> get _items => widget.replica.conflicts(_h);
+
+  Future<void> _resolve(Json c, String how) async {
+    final local = Map<String, dynamic>.from(c['local'] as Map? ?? {});
+    final server = Map<String, dynamic>.from(c['server'] as Map? ?? {});
+    final id = c['entity_id'].toString();
+    final title = local['title']?.toString() ?? 'Untitled';
+    final body = local['body_md']?.toString() ?? '';
+    if (how == 'mine') {
+      await widget.api.saveNote(id, title, body,
+          pinned: _truthy(local['pinned']),
+          baseVersion: (server['version'] as num?)?.toInt() ?? 0);
+    } else if (how == 'both') {
+      await widget.api.saveNote(newId(), '$title (conflict copy)', body);
+    }
+    await widget.replica.removeConflict(_h, c['op_id'].toString());
+    if (mounted) setState(() {});
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final items = _items;
+    return Scaffold(
+      appBar: AppBar(title: const Text('Conflicts')),
+      body: items.isEmpty
+          ? const Center(child: Text('No conflicts.'))
+          : ListView(
+              padding: const EdgeInsets.all(16),
+              children: [
+                for (final c in items)
+                  Card(
+                    child: Padding(
+                      padding: const EdgeInsets.all(16),
+                      child: Column(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          Text(
+                            (c['local'] as Map?)?['title']?.toString() ?? 'Note',
+                            style: Theme.of(context).textTheme.titleMedium,
+                          ),
+                          const SizedBox(height: 8),
+                          const Text('Your version', style: TextStyle(fontWeight: FontWeight.bold)),
+                          Text((c['local'] as Map?)?['body_md']?.toString() ?? ''),
+                          const SizedBox(height: 8),
+                          const Text('Server version', style: TextStyle(fontWeight: FontWeight.bold)),
+                          Text((((c['server'] as Map?)?['data']) as Map?)?['body_md']?.toString() ?? ''),
+                          const SizedBox(height: 8),
+                          Wrap(
+                            spacing: 8,
+                            children: [
+                              OutlinedButton(onPressed: () => _resolve(c, 'server'), child: const Text('Keep server')),
+                              OutlinedButton(onPressed: () => _resolve(c, 'mine'), child: const Text('Use mine')),
+                              FilledButton(onPressed: () => _resolve(c, 'both'), child: const Text('Keep both')),
+                            ],
+                          ),
+                        ],
+                      ),
+                    ),
+                  ),
+              ],
+            ),
+    );
+  }
+}
