+// ------------------------------------------------------------- reminders
+class RemindersPane extends StatelessWidget {
+  const RemindersPane({
+    super.key,
+    required this.reminders,
+    required this.canEdit,
+    required this.actions,
+    required this.onChanged,
+    required this.onNew,
+  });
+  final List<Json> reminders;
+  final bool canEdit;
+  final FamilyActions actions;
+  final VoidCallback onChanged;
+  final VoidCallback onNew;
+
+  Future<void> _run(BuildContext context, Future<void> Function() job) async {
+    try {
+      await job();
+      onChanged();
+    } on Object catch (e) {
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(e.toString())));
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    int byDue(Json a, Json b) => '${a['due_at']}'.compareTo('${b['due_at']}');
+    final active = reminders.where((r) => r['status'] != 'done').toList()..sort(byDue);
+    final done = reminders.where((r) => r['status'] == 'done').toList()..sort(byDue);
+    final now = DateTime.now();
+    Widget tile(Json r) {
+      final due = DateTime.tryParse('${r['due_at']}')?.toLocal();
+      final overdue = r['status'] != 'done' && due != null && due.isBefore(now);
+      return Card(
+        child: ListTile(
+          leading: Icon(
+            r['status'] == 'done'
+                ? Icons.check_circle_outline
+                : _truthy(r['urgent'])
+                ? Icons.priority_high
+                : Icons.notifications_active_outlined,
+            color: overdue ? Theme.of(context).colorScheme.error : null,
+          ),
+          title: Text(r['title']?.toString() ?? 'Reminder'),
+          subtitle: Text(
+            due == null ? 'No due date' : due.toString().substring(0, 16),
+            style: overdue ? TextStyle(color: Theme.of(context).colorScheme.error) : null,
+          ),
+          trailing: Row(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              if (r['_pending'] == true) _syncBadge(true),
+              if (canEdit)
+                PopupMenuButton<String>(
+                  onSelected: (v) => _run(context, () async {
+                    switch (v) {
+                      case 'done':
+                        await actions.setReminder(r, status: 'done');
+                      case 'reopen':
+                        await actions.setReminder(r, status: 'active');
+                      case 'delete':
+                        await actions.deleteReminder(r);
+                      default:
+                        await actions.snooze(r, v);
+                    }
+                  }),
+                  itemBuilder: (_) => [
+                    if (r['status'] == 'done')
+                      const PopupMenuItem(value: 'reopen', child: Text('Reopen'))
+                    else ...const [
+                      PopupMenuItem(value: 'done', child: Text('Mark done')),
+                      PopupMenuItem(value: '10m', child: Text('Snooze 10 min')),
+                      PopupMenuItem(value: '1h', child: Text('Snooze 1 hour')),
+                      PopupMenuItem(value: 'tomorrow', child: Text('Snooze to tomorrow')),
+                    ],
+                    const PopupMenuItem(value: 'delete', child: Text('Delete')),
+                  ],
+                ),
+            ],
+          ),
+        ),
+      );
+    }
+
+    return ListView(
+      padding: const EdgeInsets.all(16),
+      children: [
+        Row(
+          children: [
+            Expanded(child: Text('Reminders', style: Theme.of(context).textTheme.headlineSmall)),
+            if (canEdit)
+              FilledButton.icon(onPressed: onNew, icon: const Icon(Icons.add_alert), label: const Text('New reminder')),
+          ],
+        ),
+        const SizedBox(height: 12),
+        if (reminders.isEmpty)
+          const Card(
+            child: Padding(
+              padding: EdgeInsets.all(20),
+              child: Text('Create reminders for everyone or a specific family member.'),
+            ),
+          ),
+        for (final r in active) tile(r),
+        if (done.isNotEmpty)
+          ExpansionTile(title: Text('Done (${done.length})'), children: [for (final r in done) tile(r)]),
+      ],
+    );
+  }
+}
