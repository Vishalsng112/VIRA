+/// Write helpers shared by the panes. Every write goes to the outbox first.
+class FamilyActions {
+  FamilyActions(this.api);
+  final ViraApi api;
+
+  Future<void> toggleItem(Json item, bool done) => api.saveChecklistItem(
+    id: item['id'].toString(),
+    noteId: item['note_id'].toString(),
+    text: item['text']?.toString() ?? '',
+    done: done,
+    position: item['position']?.toString() ?? 'a0',
+  );
+
+  Future<void> renameItem(Json item, String text) => api.saveChecklistItem(
+    id: item['id'].toString(),
+    noteId: item['note_id'].toString(),
+    text: text,
+    done: _truthy(item['done']),
+    position: item['position']?.toString() ?? 'a0',
+  );
+
+  Future<void> deleteItems(Iterable<Json> items) =>
+      api.deleteEntities('checklist_item', items.map((i) => i['id'].toString()).toList());
+
+  Future<void> deleteList(Json list, Iterable<Json> items) async {
+    await deleteItems(items);
+    await api.deleteEntities('note', [list['id'].toString()]);
+  }
+
+  static const templates = <String, List<String>>{
+    'Groceries': ['Milk', 'Eggs', 'Bread', 'Vegetables', 'Fruit'],
+    'Packing': ['Clothes', 'Toiletries', 'Chargers', 'Documents', 'Medicines'],
+    'Chores': ['Dishes', 'Laundry', 'Take out trash', 'Vacuum', 'Water plants'],
+  };
+
+  Future<void> createFromTemplate(String name) async {
+    final listId = newId();
+    final texts = templates[name]!;
+    await api.pushOps([
+      {
+        'op_id': newId(),
+        'entity_type': 'note',
+        'entity_id': listId,
+        'op': 'upsert',
+        'base_version': 0,
+        'data': {'id': listId, 'title': name, 'body_md': '', 'pinned': false, 'kind': 'checklist'},
+      },
+      for (var i = 0; i < texts.length; i++) _templateItem(listId, texts[i], i),
+    ]);
+  }
+
+  Json _templateItem(String listId, String text, int index) {
+    final id = newId();
+    return {
+      'op_id': newId(),
+      'entity_type': 'checklist_item',
+      'entity_id': id,
+      'op': 'upsert',
+      'base_version': 0,
+      'data': {'id': id, 'note_id': listId, 'text': text, 'done': false, 'position': 'a$index'},
+    };
+  }
+
+  Future<void> setReminder(Json r, {String? status, String? dueAt}) =>
+      api.saveReminder(
+        id: r['id'].toString(),
+        title: r['title']?.toString() ?? '',
+        dueAt: dueAt ?? r['due_at']?.toString() ?? DateTime.now().toUtc().toIso8601String(),
+        urgent: _truthy(r['urgent']),
+        status: status ?? r['status']?.toString() ?? 'active',
+        body: r['body']?.toString(),
+        timezone: r['timezone']?.toString(),
+        rrule: r['rrule']?.toString(),
+      );
+
+  Future<void> snooze(Json r, String kind) {
+    final now = DateTime.now();
+    final target = switch (kind) {
+      '10m' => now.add(const Duration(minutes: 10)),
+      '1h' => now.add(const Duration(hours: 1)),
+      _ => DateTime(now.year, now.month, now.day + 1, 9),
+    };
+    return setReminder(r, dueAt: target.toUtc().toIso8601String(), status: 'active');
+  }
+
+  Future<void> deleteReminder(Json r) =>
+      api.deleteEntities('reminder', [r['id'].toString()]);
+}
