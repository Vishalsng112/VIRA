+// ------------------------------------------------------------------ chat
+class ChatPane extends StatefulWidget {
+  const ChatPane({super.key, required this.api, required this.replica, required this.online});
+  final ViraApi api;
+  final LocalReplica? replica;
+  final bool online;
+  @override
+  State<ChatPane> createState() => _ChatPaneState();
+}
+
+class _ChatPaneState extends State<ChatPane> {
+  final _input = TextEditingController();
+  final _scroll = ScrollController();
+  List<Json> _messages = [];
+  String _progress = '';
+  bool _busy = false;
+  bool _grounded = true;
+
+  @override
+  void initState() {
+    super.initState();
+    final r = widget.replica;
+    if (r != null) {
+      _messages = r.chatHistory(); // browsable offline (CFR-82)
+      _input.text = r.chatDraft;
+    }
+    _input.addListener(() => widget.replica?.setChatDraft(_input.text));
+  }
+
+  @override
+  void dispose() {
+    _input.dispose();
+    _scroll.dispose();
+    super.dispose();
+  }
+
+  void _toEnd() => WidgetsBinding.instance.addPostFrameCallback((_) {
+    if (_scroll.hasClients) _scroll.jumpTo(_scroll.position.maxScrollExtent);
+  });
+
+  String _describe(Json e) {
+    final text = e['message'] ?? e['text'] ?? e['tool'] ?? e['name'] ?? e['content'];
+    final type = e['type']?.toString() ?? 'status';
+    return text == null ? type : '$type: $text';
+  }
+
+  Future<void> _send() async {
+    final text = _input.text.trim();
+    if (text.isEmpty || _busy) return;
+    setState(() {
+      _messages.add({'role': 'user', 'text': text});
+      _input.clear();
+      _busy = true;
+      _progress = 'Thinking…';
+    });
+    _toEnd();
+    String answer = '';
+    try {
+      await for (final e in widget.api.chatStream(text, grounded: _grounded)) {
+        final type = e['type'];
+        if (type == 'done') {
+          answer = (e['response'] ?? e['message'] ?? '').toString();
+        } else if (type == 'error') {
+          answer = 'Error: ${e['detail'] ?? 'chat failed'}';
+        } else if (mounted) {
+          setState(() => _progress = _describe(e));
+        }
+      }
+      if (answer.isEmpty) answer = 'No answer received.';
+    } on Object catch (e) {
+      answer = 'Unable to reach VIRA: $e';
+    }
+    _messages.add({'role': 'assistant', 'text': answer});
+    await widget.replica?.saveChatHistory(_messages);
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _progress = '';
+    });
+    _toEnd();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    return Padding(
+      padding: const EdgeInsets.all(12),
+      child: Column(
+        children: [
+          Expanded(
+            child: _messages.isEmpty
+                ? const Center(child: Text('Ask VIRA something.'))
+                : ListView.builder(
+                    controller: _scroll,
+                    itemCount: _messages.length,
+                    itemBuilder: (_, i) {
+                      final m = _messages[i];
+                      final mine = m['role'] == 'user';
+                      return Align(
+                        alignment: mine ? Alignment.centerRight : Alignment.centerLeft,
+                        child: Container(
+                          margin: const EdgeInsets.symmetric(vertical: 4),
+                          padding: const EdgeInsets.all(12),
+                          constraints: BoxConstraints(maxWidth: MediaQuery.of(context).size.width * 0.8),
+                          decoration: BoxDecoration(
+                            color: mine ? scheme.primaryContainer : scheme.surfaceContainerHighest,
+                            borderRadius: BorderRadius.circular(12),
+                          ),
+                          child: SelectableText(m['text']?.toString() ?? ''),
+                        ),
+                      );
+                    },
+                  ),
+          ),
+          if (_busy)
+            Padding(
+              padding: const EdgeInsets.symmetric(vertical: 6),
+              child: Row(
+                children: [
+                  const SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2)),
+                  const SizedBox(width: 8),
+                  Expanded(child: Text(_progress, maxLines: 1, overflow: TextOverflow.ellipsis)),
+                ],
+              ),
+            ),
+          if (!widget.online)
+            const Padding(
+              padding: EdgeInsets.symmetric(vertical: 4),
+              child: Text('Offline: history is read-only, sending needs a connection.'),
+            ),
+          Row(
+            children: [
+              Tooltip(
+                message: 'Use family notes as context',
+                child: Switch(value: _grounded, onChanged: (v) => setState(() => _grounded = v)),
+              ),
+              Expanded(
+                child: TextField(
+                  controller: _input,
+                  enabled: widget.online && !_busy,
+                  onSubmitted: (_) => _send(),
+                  decoration: const InputDecoration(hintText: 'Message VIRA'),
+                ),
+              ),
+              IconButton(onPressed: widget.online && !_busy ? _send : null, icon: const Icon(Icons.send)),
+            ],
+          ),
+        ],
+      ),
+    );
+  }
+}
