# Copy to .env and edit as needed:  cp .env.example .env

# Network exposure. Use 127.0.0.1 for a strictly local-only server.
VIRA_BIND_ADDRESS=0.0.0.0
VIRA_PORT=8000

# Model to pull/use. Must match (or override) the Ollama model in config.yaml.
VIRA_OLLAMA_MODEL=nemotron-3.5-bolt:e4b

# Optional: override the Ollama endpoint.
# Bundled compose uses http://ollama:11434 by default.
# Native Ollama on the host: http://host.docker.internal:11434
# Remote GPU machine: https://ollama.example.internal
# VIRA_OLLAMA_URL=http://ollama:11434

# Container user mapping (mainly relevant on Linux bind mounts).
VIRA_UID=1000
VIRA_GID=1000
